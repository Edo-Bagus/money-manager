# Template for environment variables. Never put real values in this file.
# Local dev: copy to .env.local (ignored by git) and fill in.
# Vercel: Project → Settings → Environment Variables.

# Supabase → Project Settings → API Keys / Data API.
# Format: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...); a legacy anon key also works.
# It is public by design: grants and RLS protect the data, not this key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The only email allowed to use the app (server-only). Unset = nobody gets in.
ALLOWED_EMAIL=

# Shared secret for POST /api/ingest/* (sent as the X-Ingest-Token header).
# At least 32 characters; generate with: openssl rand -hex 32
INGEST_TOKEN=
